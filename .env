PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=mysecretkeychangeinproduction
JWT_REFRESH_SECRET=myrefreshsecretkeychangeinproduction
JWT_EXPIRES_IN=7d

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=12345678
PG_DATABASE=companydb

DATABASE_URL="postgresql://postgres:12345678@localhost:5432/companydb?schema=public"